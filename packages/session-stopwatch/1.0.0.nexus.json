{
  "schema": 1,
  "id": "session-stopwatch",
  "name": "Session Stopwatch",
  "description": "Meet je sessie of speedrun en bewaar rondetijden zolang de widget openstaat.",
  "kind": "widget",
  "version": "1.0.0",
  "minNexus": "1.3.0",
  "author": "Nexus Studio",
  "accent": "#91c9cb",
  "permissions": [],
  "content": {
    "type": "sandbox",
    "height": 345,
    "html": "<!doctype html><html lang=\"nl\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>:root{color-scheme:dark;font-family:'Segoe UI',sans-serif;color:#dbe6e3;background:#141b22}*{box-sizing:border-box}body{margin:0;padding:22px;font-size:13px}h1,h2,h3,p{margin:0}h2{font-size:19px;font-weight:500;letter-spacing:-.5px}p{color:#8fa3a0;font-size:11px;line-height:1.8;margin:8px 0 18px}button,input,select{font:inherit}button{background:#243b35;border:1px solid #a7e6c722;border-radius:7px;color:#b6e5ce;padding:9px 13px;cursor:pointer}button:hover{background:#315046}input,select{background:#10171c;border:1px solid #ffffff15;border-radius:7px;padding:10px;color:#dbe6e3;min-width:0}input:focus,button:focus{outline:1px solid #a7e6c7}.row{display:flex;align-items:center;gap:10px;margin:14px 0}.row input{flex:1}.muted{color:#8fa3a0;font-size:10px}.big{font-size:43px;font-weight:350;letter-spacing:-1.5px;font-variant-numeric:tabular-nums;margin:18px 0}.card{background:#ffffff04;border:1px solid #ffffff09;border-radius:9px;padding:14px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}#notice{font-size:10px;color:#e5aa9c;min-height:12px;margin-top:10px}ul{list-style:none;padding:0;margin:0}li{display:flex;align-items:center;gap:10px;border-bottom:1px solid #ffffff09;padding:10px 0}li span{flex:1;overflow-wrap:anywhere}li button{padding:4px 7px;font-size:10px}small{display:block;margin-top:5px;color:#8fa3a0;font-size:10px}@media(max-width:300px){body{padding:15px}.big{font-size:32px}}</style><body><h2>Maak elke seconde mee.</h2><div id=\"time\" class=\"big\">00:00.0</div><div class=\"row\"><button id=\"toggle\">Start</button><button id=\"lap\">Ronde</button><button id=\"reset\">Reset</button></div><ul id=\"laps\"></ul><div id=\"notice\" role=\"status\"></div><script>window.nexusStorage={request(action,value){return new Promise((resolve,reject)=>{const requestId=crypto.randomUUID();const timeout=setTimeout(()=>{window.removeEventListener('message',listen);reject(Error('Opslag reageert niet.'));},7000);function listen(e){if(e.source!==parent||e.data?.channel!=='nexus-extension-response'||e.data.requestId!==requestId)return;clearTimeout(timeout);window.removeEventListener('message',listen);e.data.error?reject(Error(e.data.error)):resolve(e.data.value);}window.addEventListener('message',listen);parent.postMessage({channel:'nexus-extension-v1',requestId,action,value},'*');});},load(){return this.request('load');},save(value){return this.request('save',value);}};window.addEventListener('unhandledrejection',e=>{document.getElementById('notice').textContent=e.reason?.message||'Opslaan mislukt.';});\nlet start=0,elapsed=0,running=false;const format=ms=>{const n=Math.floor(ms/100);return Math.floor(n/600).toString().padStart(2,'0')+':'+Math.floor(n%600/10).toString().padStart(2,'0')+'.'+n%10;};const value=()=>elapsed+(running?Date.now()-start:0);document.getElementById('toggle').onclick=()=>{if(running)elapsed=value();else start=Date.now();running=!running;document.getElementById('toggle').textContent=running?'Pauze':'Start';};document.getElementById('reset').onclick=()=>{elapsed=0;start=Date.now();document.getElementById('laps').replaceChildren();};document.getElementById('lap').onclick=()=>{const list=document.getElementById('laps');if(list.children.length>=20)return;const row=document.createElement('li');row.textContent='Ronde '+(list.children.length+1)+' · '+format(value());list.prepend(row);};setInterval(()=>document.getElementById('time').textContent=format(value()),100);</script></body></html>"
  }
}
