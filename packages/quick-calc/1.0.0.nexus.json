{
  "schema": 1,
  "id": "quick-calc",
  "name": "Quick Calc",
  "description": "Een compacte rekenmachine voor je dashboard. Rekent volledig lokaal, zonder account.",
  "kind": "tool",
  "version": "1.0.0",
  "minNexus": "1.3.0",
  "author": "Nexus Studio",
  "accent": "#c1ace6",
  "permissions": [],
  "content": {
    "type": "sandbox",
    "height": 420,
    "html": "<!doctype html><html lang=\"nl\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>:root{color-scheme:dark;font-family:'Segoe UI',sans-serif;color:#dbe6e3;background:#141b22}*{box-sizing:border-box}body{margin:0;padding:22px;font-size:13px}h1,h2,h3,p{margin:0}h2{font-size:19px;font-weight:500;letter-spacing:-.5px}p{color:#8fa3a0;font-size:11px;line-height:1.8;margin:8px 0 18px}button,input,select{font:inherit}button{background:#243b35;border:1px solid #a7e6c722;border-radius:7px;color:#b6e5ce;padding:9px 13px;cursor:pointer}button:hover{background:#315046}input,select{background:#10171c;border:1px solid #ffffff15;border-radius:7px;padding:10px;color:#dbe6e3;min-width:0}input:focus,button:focus{outline:1px solid #a7e6c7}.row{display:flex;align-items:center;gap:10px;margin:14px 0}.row input{flex:1}.muted{color:#8fa3a0;font-size:10px}.big{font-size:43px;font-weight:350;letter-spacing:-1.5px;font-variant-numeric:tabular-nums;margin:18px 0}.card{background:#ffffff04;border:1px solid #ffffff09;border-radius:9px;padding:14px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}#notice{font-size:10px;color:#e5aa9c;min-height:12px;margin-top:10px}ul{list-style:none;padding:0;margin:0}li{display:flex;align-items:center;gap:10px;border-bottom:1px solid #ffffff09;padding:10px 0}li span{flex:1;overflow-wrap:anywhere}li button{padding:4px 7px;font-size:10px}small{display:block;margin-top:5px;color:#8fa3a0;font-size:10px}@media(max-width:300px){body{padding:15px}.big{font-size:32px}}#display{width:100%;text-align:right;font-size:26px;margin:0 0 14px;background:#10171c}#keys{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}#keys button{font-size:17px;padding:10px}</style><body><h2>Quick Calc</h2><p>Even uitrekenen. Meteen verder.</p><input id=\"display\" aria-label=\"Berekening\" value=\"0\" readonly><div id=\"keys\"></div><div id=\"notice\" role=\"status\"></div><script>window.nexusStorage={request(action,value){return new Promise((resolve,reject)=>{const requestId=crypto.randomUUID();const timeout=setTimeout(()=>{window.removeEventListener('message',listen);reject(Error('Opslag reageert niet.'));},7000);function listen(e){if(e.source!==parent||e.data?.channel!=='nexus-extension-response'||e.data.requestId!==requestId)return;clearTimeout(timeout);window.removeEventListener('message',listen);e.data.error?reject(Error(e.data.error)):resolve(e.data.value);}window.addEventListener('message',listen);parent.postMessage({channel:'nexus-extension-v1',requestId,action,value},'*');});},load(){return this.request('load');},save(value){return this.request('save',value);}};window.addEventListener('unhandledrejection',e=>{document.getElementById('notice').textContent=e.reason?.message||'Opslaan mislukt.';});\nlet value='';const display=document.getElementById('display');function evaluate(s){const tokens=s.match(/[0-9]*[.]?[0-9]+|[+*/()-]/g)||[];if(tokens.join('')!==s||tokens.length>70)throw Error('Ongeldige berekening');let index=0;function atom(){let t=tokens[index++];if(t==='-')return -atom();if(t==='('){const n=sum();if(tokens[index++]!==')')throw Error('Haakjes');return n;}const n=Number(t);if(!Number.isFinite(n))throw Error('Getal');return n;}function product(){let n=atom();while(['*','/'].includes(tokens[index])){const op=tokens[index++],r=atom();n=op==='*'?n*r:n/r;}return n;}function sum(){let n=product();while(['+','-'].includes(tokens[index])){const op=tokens[index++],r=product();n=op==='+'?n+r:n-r;}return n;}const result=sum();if(index!==tokens.length||!Number.isFinite(result))throw Error('Kan niet delen door nul');return Math.round(result*1e10)/1e10;}for(const key of ['C','(',')','÷','7','8','9','×','4','5','6','−','1','2','3','+','⌫','0','.','=']){const button=document.createElement('button');button.textContent=key;button.onclick=()=>{try{if(key==='C')value='';else if(key==='⌫')value=value.slice(0,-1);else if(key==='=')value=String(evaluate(value));else if(value.length<80)value+=({'÷':'/','×':'*','−':'-'})[key]||key;display.value=value||'0';document.getElementById('notice').textContent='';}catch(e){document.getElementById('notice').textContent=e.message;}};document.getElementById('keys').append(button);}</script></body></html>"
  }
}
